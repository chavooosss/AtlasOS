#!/bin/bash
set -euo pipefail

readonly CURL=/usr/bin/curl
readonly DPKG_DEB=/usr/bin/dpkg-deb
readonly APT_GET=/usr/bin/apt-get
readonly MKTEMP=/usr/bin/mktemp
readonly RM=/usr/bin/rm
readonly GREP=/usr/bin/grep
readonly FINDMNT=/usr/bin/findmnt
readonly PACKAGE_URL=https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb

fail() {
  local code="$1"
  shift
  printf '%s\n' "$*" >&2
  exit "$code"
}

if (( $# != 0 )); then
  fail 64 'The Chrome installer does not accept arguments.'
fi
if (( EUID != 0 )); then
  fail 77 'The Chrome installer requires the dedicated desktop authorization action.'
fi

for tool in "$CURL" "$DPKG_DEB" "$APT_GET" "$MKTEMP" "$RM" "$GREP" "$FINDMNT"; do
  if [[ ! -x "$tool" ]]; then
    fail 69 'A required system installer tool is unavailable.'
  fi
done

is_casper_live() {
  local mount_info filesystem options option
  [[ -r /proc/cmdline ]] || return 1
  "$GREP" -Eq '(^|[[:space:]])boot=casper([[:space:]]|$)' /proc/cmdline || return 1
  mount_info="$("$FINDMNT" --noheadings --raw --mountpoint /rofs --output FSTYPE,OPTIONS 2>/dev/null)" || return 1
  read -r filesystem options <<<"$mount_info"
  [[ "$filesystem" == squashfs ]] || return 1
  IFS=',' read -r -a mount_options <<<"$options"
  for option in "${mount_options[@]}"; do
    [[ "$option" == ro ]] && return 0
  done
  return 1
}

if ! is_casper_live; then
  fail 78 'Chrome installation is available only in an AtlasOS Casper Live session.'
fi

umask 077
work_dir="$("$MKTEMP" -d /var/tmp/atlasos-chrome-install.XXXXXX)" || fail 69 'Could not create a secure temporary directory.'
trap '"$RM" -rf -- "$work_dir"' EXIT
package_file="${work_dir}/google-chrome-stable_current_amd64.deb"

printf '%s\n' 'ATLASOS_STAGE:download'
if ! "$CURL" --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
  --connect-timeout 20 --max-time 240 "$PACKAGE_URL" --output "$package_file"; then
  fail 69 'The official Google Chrome package could not be downloaded.'
fi

printf '%s\n' 'ATLASOS_STAGE:verify'
if ! package_name="$("$DPKG_DEB" --field "$package_file" Package)" \
  || ! package_arch="$("$DPKG_DEB" --field "$package_file" Architecture)" \
  || ! package_version="$("$DPKG_DEB" --field "$package_file" Version)"; then
  fail 65 'The downloaded file has invalid Debian package metadata.'
fi
if [[ "$package_name" != google-chrome-stable || "$package_arch" != amd64 || ! "$package_version" =~ ^[0-9][A-Za-z0-9.+:~_-]*$ ]]; then
  fail 65 'The downloaded package is not a valid stable amd64 Google Chrome package.'
fi

printf '%s\n' 'ATLASOS_STAGE:index'
if ! "$APT_GET" update; then
  fail 70 'Package index refresh failed; Chrome was not installed.'
fi
printf '%s\n' 'ATLASOS_STAGE:install'
if ! DEBIAN_FRONTEND=noninteractive "$APT_GET" install -y --no-install-recommends "$package_file"; then
  fail 70 'Chrome package installation failed.'
fi
if [[ ! -x /usr/bin/google-chrome-stable ]]; then
  fail 71 'Installation finished without the expected Chrome launcher.'
fi

printf '%s\n' 'ATLASOS_STAGE:complete'
