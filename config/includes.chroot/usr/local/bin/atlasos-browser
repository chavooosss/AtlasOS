#!/usr/bin/env bash
set -euo pipefail

ATLAS_HOME_URL="https://chavooosss.github.io/AtlasOS/"
url="${1:-${ATLAS_HOME_URL}}"
if [[ -z "${url}" || "${url}" == "about:blank" ]]; then
  url="${ATLAS_HOME_URL}"
fi

log_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/atlasos"
mkdir -p "${log_dir}"
log="${log_dir}/browser.log"

show_error() {
  printf '%s\n' "$1" >>"${log}"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="AtlasOS" \
      --text="$(printf '%s\n\nAyrintilar: %s' "$1" "${log}")" \
      >/dev/null 2>&1 || true
  fi
  printf '%s (ayrintilar: %s)\n' "$1" "${log}" >&2
}

browser=""
for candidate in google-chrome-stable google-chrome chromium chromium-browser firefox; do
  if command -v "${candidate}" >/dev/null 2>&1; then
    browser="$(command -v "${candidate}")"
    break
  fi
done

{
  echo "==== $(date -Is) ===="
  echo "URL: [redacted]"
  echo "DISPLAY: ${DISPLAY:-}"
  echo "XDG_SESSION_TYPE: ${XDG_SESSION_TYPE:-}"
  echo "Selected browser: ${browser:-none}"
} >>"${log}" 2>&1

if [[ -z "${browser}" ]]; then
  if ! command -v zenity >/dev/null 2>&1; then
    show_error "Harici web tarayıcısı yüklü değil. AtlasOS içi web görünümünü kullanabilirsiniz."
    exit 127
  fi
  if ! command -v pkexec >/dev/null 2>&1; then
    show_error "Chrome bu Live sistemde yüklü değil ve güvenli kurulum aracı bulunamadı. AtlasOS içi web görünümünü kullanabilirsiniz."
    exit 127
  fi

  if zenity --question \
    --title="AtlasOS · Google Chrome" \
    --width=560 \
    --ok-label="Şartları inceledim · indir" \
    --cancel-label="Vazgeç" \
    --text="Google Chrome AtlasOS'a dahil edilmez. İstersen resmi Google Linux paketini indirip kurabilirsin.\n\nİndirmeden önce Google koşullarını incele:\nhttps://policies.google.com/terms\nhttps://www.google.com/chrome/terms/\n\nDevam düğmesi, Google'ın indirme koşulları kapsamında paketi istemen anlamına gelir. Chrome ilk açılışında gösterilen koşulları AtlasOS senin adına kabul etmez. Kurulum ayrıca Google'ın resmi güncelleme deposunu etkinleştirir."; then
    # A private FIFO keeps the progress window independent of APT. Closing the
    # window cannot cancel a package transaction or affect the privileged helper.
    progress_dir="$(mktemp -d "${log_dir}/chrome-progress.XXXXXX")"
    progress_fifo="${progress_dir}/events"
    mkfifo -- "${progress_fifo}"
    zenity --progress --pulsate --no-cancel --auto-close \
      --title="AtlasOS · Google Chrome" --width=520 \
      --text="Kurulum hazırlanıyor…" <"${progress_fifo}" >/dev/null 2>&1 &
    progress_pid=$!
    exec {progress_fd}<>"${progress_fifo}"
    printf '# Kurulum hazırlanıyor…\n' >&"${progress_fd}"
    set +e
    pkexec /usr/local/libexec/atlasos-install-google-chrome 2>>"${log}" | while IFS= read -r line; do
      case "${line}" in
        ATLASOS_STAGE:download) printf '# Google Chrome indiriliyor…\n' >&"${progress_fd}" ;;
        ATLASOS_STAGE:verify) printf '# İndirilen paket doğrulanıyor…\n' >&"${progress_fd}" ;;
        ATLASOS_STAGE:index) printf '# Paket kaynakları güncelleniyor…\n' >&"${progress_fd}" ;;
        ATLASOS_STAGE:install) printf '# Google Chrome kuruluyor…\n' >&"${progress_fd}" ;;
        ATLASOS_STAGE:complete) printf '# Kurulum tamamlandı. Tarayıcı açılıyor…\n' >&"${progress_fd}" ;;
        *) printf '%s\n' "${line}" >>"${log}" ;;
      esac
    done
    status=${PIPESTATUS[0]}
    set -e
    if (( status == 0 )); then
      printf '100\n' >&"${progress_fd}"
    else
      kill -TERM "${progress_pid}" 2>/dev/null || true
    fi
    exec {progress_fd}>&-
    wait "${progress_pid}" 2>/dev/null || true
    rm -f -- "${progress_fifo}"
    rmdir -- "${progress_dir}"
    if (( status != 0 )); then
      case "$status" in
        64) message="Chrome kurulum isteği geçersiz; kullanıcı argümanı kabul edilmiyor." ;;
        65) message="Google'dan indirilen paket doğrulanamadı. Chrome kurulmadı." ;;
        69) message="Google Chrome paketi indirilemedi veya gerekli sistem aracı bulunamadı. Ağ bağlantısını kontrol edip yeniden deneyin." ;;
        70) message="Paket yöneticisi Chrome kurulumunu tamamlayamadı. İnternet bağlantısını kontrol edip yeniden deneyin." ;;
        71) message="Kurulum tamamlandı fakat Chrome başlatıcısı bulunamadı." ;;
        77) message="Chrome kurucusu gerekli yetkiyle başlatılamadı." ;;
        78) message="Chrome kurulumu yalnızca AtlasOS Live oturumunda kullanılabilir." ;;
        126) message="Chrome kurulum isteği iptal edildi." ;;
        127) message="Bu oturumda Chrome kurulum yetkisi alınamadı. AtlasOS Live oturumunda yeniden deneyin." ;;
        *) message="Google Chrome kurulumu başarısız oldu (hata kodu: ${status})." ;;
      esac
      show_error "$message"
      exit "$status"
    fi
  else
    exit 0
  fi

  for candidate in google-chrome-stable google-chrome chromium chromium-browser firefox; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      browser="$(command -v "${candidate}")"
      break
    fi
  done
  if [[ -z "${browser}" ]]; then
    show_error "Kurulum tamamlandı ancak başlatılabilir tarayıcı bulunamadı."
    exit 127
  fi
fi

# Serialize duplicate launch requests and retry one transient SIGKILL/137 exit.
exec 9>"${log_dir}/browser-launch.lock"
if ! flock -w 20 9; then
  show_error "Web tarayıcısı başlatılıyor. Birkaç saniye sonra yeniden deneyin."
  exit 75
fi

for attempt in 1 2; do
  if "${browser}" --new-window "${url}" >>"${log}" 2>&1; then
    exit 0
  else
    status=$?
  fi

  printf 'Browser launch attempt %s exited with status %s\n' "${attempt}" "${status}" >>"${log}"
  if [[ "${status}" == "137" && "${attempt}" == "1" ]]; then
    sleep 2
    continue
  fi
  show_error "Web tarayıcısı açılamadı (hata kodu: ${status})."
  exit "${status}"
done
