#!/usr/bin/env python3
import os
import pathlib
import subprocess
import sys
from urllib.parse import parse_qs, unquote, urlparse


SUFFIXES = {
    "pdf": {".pdf"},
    "presentation": {".odp", ".ppt", ".pptx"},
    "video": {".mp4", ".mkv", ".webm", ".avi"},
    "office": {".odt", ".doc", ".docx", ".ods", ".xls", ".xlsx"},
    "text": {".txt"},
    "image": {".png", ".jpg", ".jpeg", ".webp"},
}


def fail(message):
    log_dir = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")) / "atlasos"
    log_dir.mkdir(parents=True, exist_ok=True)
    log = log_dir / "tools.log"
    with log.open("a", encoding="utf-8") as stream:
        stream.write(message + "\n")
    subprocess.run(
        ["zenity", "--error", "--title=AtlasOS", "--text=" + message + "\n\nAyrintilar: " + str(log)],
        check=False,
    )
    return 1


def open_file(query):
    kind = query.get("kind", [""])[0]
    file_url = urlparse(query.get("url", [""])[0])
    if file_url.scheme != "file" or file_url.netloc not in ("", "localhost"):
        return fail("Yalnizca yerel dosyalar acilabilir.")
    path = pathlib.Path(unquote(file_url.path)).resolve()
    home = pathlib.Path.home().resolve()
    roots = [home, pathlib.Path("/media").resolve(), pathlib.Path("/run/media").resolve()]
    if not path.is_file() or not any(path.is_relative_to(root) for root in roots):
        return fail("Dosya bulunamadi veya erisime izin verilmiyor.")
    suffix = path.suffix.lower()
    if kind == "auto":
        kind = next((name for name, extensions in SUFFIXES.items() if suffix in extensions), "")
    if kind not in SUFFIXES or suffix not in SUFFIXES[kind]:
        return fail("Bu dosya turu AtlasOS icinden acilamiyor.")
    commands = {
        "pdf": ["evince", str(path)],
        "presentation": ["libreoffice", "--impress", str(path)],
        "video": ["vlc", str(path)],
        "office": ["libreoffice", str(path)],
        "text": ["mousepad", str(path)],
        "image": ["ristretto", str(path)],
    }
    try:
        subprocess.Popen(commands[kind], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        return fail("Uygulama baslatilamadi: " + str(error))
    return 0


def open_browser(query):
    url = query.get("url", [""])[0]
    parsed = urlparse(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        return fail("Web adresi gecersiz.")
    try:
        subprocess.Popen(["atlasos-browser", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        return fail("Web tarayicisi baslatilamadi: " + str(error))
    return 0


def main():
    request = urlparse("atlasos://" + sys.argv[1])
    query = parse_qs(request.query)
    if request.netloc == "open-file":
        return open_file(query)
    if request.netloc == "browser":
        return open_browser(query)
    return fail("Bilinmeyen AtlasOS islemi.")


if __name__ == "__main__":
    sys.exit(main())
