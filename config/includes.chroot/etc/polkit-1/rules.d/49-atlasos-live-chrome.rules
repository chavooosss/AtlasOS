polkit.addRule(function (action, subject) {
    if (action.id !== "org.atlasos.install-google-chrome") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.user !== "atlas" || subject.active !== true || subject.local !== true) {
        return polkit.Result.NOT_HANDLED;
    }

    try {
        polkit.spawn([
            "/usr/bin/grep",
            "-Eq",
            "(^|[[:space:]])boot=casper([[:space:]]|$)",
            "/proc/cmdline"
        ]);
        var mountInfo = polkit.spawn([
            "/usr/bin/findmnt",
            "--noheadings",
            "--raw",
            "--mountpoint",
            "/rofs",
            "--output",
            "FSTYPE,OPTIONS"
        ]).trim();
        var fields = mountInfo.split(/\s+/);
        if (fields.length < 2 || fields[0] !== "squashfs" || fields[1].split(",").indexOf("ro") === -1) {
            return polkit.Result.NOT_HANDLED;
        }
        return polkit.Result.YES;
    } catch (error) {
        return polkit.Result.NOT_HANDLED;
    }
});
