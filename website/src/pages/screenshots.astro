---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import ProductCapture from "../components/ProductCapture.astro";
---

<SiteLayout
  title="Screenshots"
  active="/screenshots/"
  description="Two authentic product captures from the AtlasOS desktop and UEFI boot experience."
>
  <PageHero
    eyebrow="Current AtlasOS captures"
    title="The product, as it is."
    text="These two images show the AtlasOS Live desktop and Atlas Boot Manager. The gallery contains actual product captures only."
  />
  <section class="page-content">
    <div class="shell">
      <div class="gallery gallery-authentic" aria-label="AtlasOS product captures">
        <ProductCapture
          src="/AtlasOS/images/atlasos-live-desktop.jpeg"
          alt="AtlasOS Live desktop with classroom navigation, teaching shortcuts, system status, and lesson schedule"
          title="AtlasOS Live desktop"
          caption="A real desktop capture from AtlasOS 0.6.2."
          kind="desktop"
          eager={true}
        />
        <ProductCapture
          src="/AtlasOS/images/atlasos-boot-manager.png"
          alt="AtlasOS boot menu showing Start Live, Advanced Options, Start from Disk, and System Tools"
          title="Atlas Boot Manager"
          caption="A real boot-menu capture. Firmware appearance can vary by device."
          kind="boot"
        />
      </div>
      <p class="gallery-footnote">
        Only approved AtlasOS product captures appear as product imagery on this
        page. Brand artwork elsewhere is decorative and does not depict the
        running interface.
      </p>
    </div>
  </section>
</SiteLayout>
