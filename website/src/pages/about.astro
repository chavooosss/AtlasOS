---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
---

<SiteLayout
  title="About"
  active="/about/"
  description="Learn about the goals, principles, and technology behind the independent AtlasOS project."
>
  <PageHero
    eyebrow="An independent open project"
    title="About AtlasOS."
    text="AtlasOS explores a more classroom-oriented experience on top of established Linux technology — shaped for teaching workflows and interactive-board environments."
  />
  <section class="page-content">
    <div class="shell">
      <div class="content-block split">
        <div>
          <span class="eyebrow">Our goal</span><h2>
            Make classroom computing feel more focused.
          </h2><p>
            AtlasOS began with a practical question: could a Live Linux
            environment help teachers get to the tools they use in class with
            less friction?
          </p><p>
            The answer is being explored through a custom desktop, system
            integration, and an Atlas-specific UEFI boot frontend. The project
            is early, and usability research and broad device qualification
            remain future work.
          </p><a
            class="button button-primary"
            href={site.repo}
            target="_blank"
            rel="noreferrer">Explore the source ↗</a>
        </div><aside class="brand-note-card">
          <span class="eyebrow">Independent project</span>
          <span class="brand-note-monogram" aria-hidden="true">A</span>
          <p>Built around a simple idea: make classroom computing feel more focused.</p>
        </aside>
      </div><div class="content-block">
        <span class="eyebrow">Technology stack</span><h2>
          Built on familiar foundations.
        </h2><p>
          AtlasOS integrates selected upstream projects and services rather than
          replacing their work.
        </p><div class="stack-list">
          <div class="stack-item">Ubuntu Live</div><div class="stack-item">
            Linux kernel
          </div><div class="stack-item">Qt 6 / QML</div><div class="stack-item">
            Python / PySide6
          </div><div class="stack-item">Rust UEFI app</div><div
            class="stack-item"
          >
            GRUB backend
          </div><div class="stack-item">Plymouth</div><div class="stack-item">
            XFCE session
          </div>
        </div>
      </div><div class="content-block split">
        <div>
          <span class="eyebrow">Open and transparent</span><h2>
            Built in the open, with clear limits.
          </h2><p>
            AtlasOS-owned source is available under the MIT License. Third-party
            packages and assets retain their own licensing terms. The project
            does not claim official affiliation with Canonical, Ubuntu, or
            education services.
          </p>
        </div><div class="benefit">
          <div class="icon-tile">↗</div><h3>Continuously improving</h3><p>
            Build notes, validation scope, known limitations, and future work
            are recorded alongside the source.
          </p><a href={site.roadmap} class="text-link">See the roadmap →</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
