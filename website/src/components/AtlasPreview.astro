---
const { compact = false } = Astro.props;
---

<div
  class:list={{ "device-frame": true, compact }}
  aria-label="Illustrative AtlasOS desktop interface preview"
>
  <div class="device-top">
    <span class="camera"></span><span class="device-dots"
      ><i></i><i></i><i></i></span>
  </div>
  <div class="desktop-preview">
    <aside class="preview-sidebar">
      <div class="preview-brand">
        <img src="/AtlasOS/images/atlas-mark.svg" alt="" />
        <b>AtlasOS</b>
      </div><div class="preview-nav selected"><span>⌂</span> Ana Sayfa</div><div
        class="preview-nav"
      >
        <span>▤</span> Dersler
      </div><div class="preview-nav"><span>▣</span> Dosyalar</div><div
        class="preview-nav"
      >
        <span>⚙</span> Ayarlar
      </div><div class="preview-nav"><span>ⓘ</span> Hakkında</div>
    </aside>
    <div class="preview-main">
      <div class="preview-topline">
        <span>◉ Wi-Fi <small>Bağlı</small></span><span
          >◖ Ses <small>%82</small></span
        ><span>✎ Kalem <small>Hazır</small></span><span>09:24</span>
      </div><div class="preview-content">
        <div class="preview-welcome">
          <small>ATLASOS · SINIF ORTAMI</small><h3>Günaydın, öğretmenim</h3><p>
            Ders araçlarınız elinizin altında.
          </p>
        </div><div class="preview-columns">
          <div>
            <strong>Ders Araçları</strong><div class="preview-cards">
              <div>▧ <b>PDF Aç</b></div><div>▱ <b>Sunum Aç</b></div><div>
                ▹ <b>Video Aç</b>
              </div><div>✎ <b>Beyaz Tahta</b></div>
            </div>
          </div><div class="preview-agenda">
            <strong>Bugünkü Ders</strong><span>09:40 — Seçmeli Fizik</span><span
              >10:30 — Tarih</span
            ><span>11:20 — Türk Dili</span>
          </div>
        </div>
      </div><div class="preview-dock"><i>▧</i><i>▰</i><i>◫</i><i>✎</i></div>
    </div>
  </div>
  <div class="device-chin"><span>ATLAS</span></div>
  <p class="preview-caption">
    Illustrative interface preview · not a product screenshot
  </p>
</div>
